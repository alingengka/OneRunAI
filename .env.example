# Copy to .env.local for local dev. On Vercel, add each of these under
# Project → Settings → Environment Variables.

# --- Supabase (your own project: Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Server only. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# --- AI providers (server only) ---
# Required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Recommended for Lao: https://elevenlabs.io (Speech to Text)
ELEVENLABS_API_KEY=
# Optional: extra transcription candidates
OPENAI_API_KEY=
# Optional: B-roll GIF search (https://partner.klipy.com)
KLIPY_API_KEY=
# Optional: free stock videos and photos for B-roll (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=

# Optional model overrides
# GEMINI_TRANSCRIBE_MODEL=gemini-3.7-flash
# GEMINI_TRANSLATE_MODEL=gemini-2.5-flash
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
